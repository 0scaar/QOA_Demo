@model QOA.DEMO.Entidades.PolizaBE
@{ ViewBag.Title = "Protección de tarjeta"; }
<div class="page-header"><h2>Emisión - Protección de Tarjeta</h2></div>
@if (ViewBag.Mensaje != null) { <div class="alert alert-danger">@ViewBag.Mensaje</div> }
@using (Html.BeginForm("ProteccionTarjeta", "Emision", FormMethod.Post, new { @class = "form-horizontal" }))
{
    <div class="panel panel-default"><div class="panel-heading"><strong>Datos del contratante</strong></div><div class="panel-body">
        <div class="form-group"><label class="col-sm-2 control-label">DNI</label><div class="col-sm-4"><input name="contratante.numeroDocumento" value="@Model.contratante.numeroDocumento" class="form-control" maxlength="8" required /></div><label class="col-sm-2 control-label">Nombre completo</label><div class="col-sm-4"><input name="contratante.nombreCompleto" value="@Model.contratante.nombreCompleto" class="form-control" required /></div></div>
        <div class="form-group"><label class="col-sm-2 control-label">Correo</label><div class="col-sm-4"><input name="contratante.correo" value="@Model.contratante.correo" class="form-control" type="email" /></div><label class="col-sm-2 control-label">Teléfono</label><div class="col-sm-4"><input name="contratante.telefono" value="@Model.contratante.telefono" class="form-control" /></div></div>
    </div></div>
    <div class="panel panel-default"><div class="panel-heading"><strong>Datos de la tarjeta y cobertura</strong></div><div class="panel-body">
        <div class="form-group"><label class="col-sm-2 control-label">Banco</label><div class="col-sm-4"><select name="banco" class="form-control"><option>BCP</option><option>BBVA</option><option>Interbank</option><option>Scotiabank</option></select></div><label class="col-sm-2 control-label">Tipo de tarjeta</label><div class="col-sm-4"><select name="tipoTarjeta" class="form-control"><option>Visa</option><option>Mastercard</option><option>American Express</option></select></div></div>
        <div class="form-group"><label class="col-sm-2 control-label">Últimos 4 dígitos</label><div class="col-sm-4"><input name="ultimosDigitosTarjeta" class="form-control" maxlength="4" required /></div><label class="col-sm-2 control-label">Línea de crédito</label><div class="col-sm-4"><input name="lineaCredito" value="@Model.lineaCredito" class="form-control" type="number" step="0.01" /></div></div>
        <div class="form-group"><label class="col-sm-2 control-label">Plan</label><div class="col-sm-4"><select name="planTarjeta" class="form-control"><option>PLAN 1</option><option selected>PLAN 2</option><option>PLAN 3</option></select></div><label class="col-sm-2 control-label">Vigencia</label><div class="col-sm-2"><input name="fecIniVigencia" value="@Model.fecIniVigencia" class="form-control" type="date" /></div><div class="col-sm-2"><input name="fecFinVigencia" value="@Model.fecFinVigencia" class="form-control" type="date" /></div></div>
    </div></div>
    <div class="text-right"><a href="@Url.Action("Index", "Home")" class="btn btn-default">Cancelar</a> <button class="btn btn-primary" type="submit"><span class="glyphicon glyphicon-ok"></span> Emitir póliza</button></div>
}
