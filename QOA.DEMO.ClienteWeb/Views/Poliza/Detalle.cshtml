@model QOA.DEMO.Entidades.PolizaBE
@{ ViewBag.Title = "Detalle de póliza"; }
<div class="page-header"><h2>Detalle de Póliza <small>@Model.numPoliza</small></h2></div>
@if (TempData["Mensaje"] != null) { <div class="alert alert-info">@TempData["Mensaje"]</div> }
<div class="row"><div class="col-md-8">
    <div class="panel panel-default"><div class="panel-heading"><strong>Información general</strong> <span class="label pull-right @(Model.estado == "EMITIDA" ? "label-success" : "label-danger")">@Model.estado</span></div><div class="panel-body"><dl class="dl-horizontal"><dt>Producto</dt><dd>@Model.descripcionProducto</dd>@if (!string.IsNullOrEmpty(Model.nombreCompania)) { <dt>Compañía</dt><dd><strong>@Model.nombreCompania</strong></dd><dt>Cotización</dt><dd>@Model.numCotizacion</dd> }<dt>Contratante</dt><dd>@Model.contratante.nombreCompleto</dd><dt>Documento</dt><dd>@Model.contratante.numeroDocumento</dd><dt>Emisión</dt><dd>@Model.fecEmision</dd><dt>Vigencia</dt><dd>@Model.fecIniVigencia - @Model.fecFinVigencia</dd><dt>Prima neta</dt><dd>S/ @Model.primaNeta.ToString("N2")</dd><dt>IGV</dt><dd>S/ @Model.igv.ToString("N2")</dd><dt>Prima total</dt><dd><strong>S/ @Model.primaTotal.ToString("N2")</strong></dd>@if (Model.deducible > 0) { <dt>Deducible referencial</dt><dd>S/ @Model.deducible.ToString("N2")</dd> }</dl></div></div>
    @if (Model.tipoProducto == "TARJETA") { <div class="panel panel-default"><div class="panel-heading"><strong>Riesgo - Tarjeta</strong></div><div class="panel-body"><dl class="dl-horizontal"><dt>Banco</dt><dd>@Model.banco</dd><dt>Tarjeta</dt><dd>@Model.tipoTarjeta terminada en @Model.ultimosDigitosTarjeta</dd><dt>Plan</dt><dd>@Model.planTarjeta</dd></dl></div></div> }
    else { <div class="panel panel-default"><div class="panel-heading"><strong>Riesgo - Vehículo</strong></div><div class="panel-body"><dl class="dl-horizontal"><dt>Placa</dt><dd>@Model.placa</dd><dt>Vehículo</dt><dd>@Model.marca @Model.modelo (@Model.anioFabricacion)</dd><dt>Uso</dt><dd>@Model.usoVehiculo</dd><dt>Valor comercial</dt><dd>S/ @Model.valorComercial.ToString("N2")</dd><dt>Auto de Reemplazo</dt><dd>@(Model.autoReemplazo ? "Sí" : "No")</dd></dl></div></div> }
    <div class="panel panel-default"><div class="panel-heading"><strong>Coberturas</strong></div><ul class="list-group">@foreach (string c in Model.coberturas) { <li class="list-group-item">@c</li> }</ul></div>
</div><div class="col-md-4">
    <div class="panel panel-warning"><div class="panel-heading"><strong>Acciones</strong></div><div class="panel-body"><a href="@Url.Action("Index")" class="btn btn-default btn-block">Volver a la consulta</a>@if (Model.estado == "EMITIDA") { <hr /><button class="btn btn-danger btn-block" data-toggle="modal" data-target="#modalAnular"><span class="glyphicon glyphicon-remove"></span> Anular póliza</button> }</div></div>
    @if (Model.estado == "ANULADA") { <div class="alert alert-danger"><strong>Anulada:</strong> @Model.fechaAnulacion<br />@Model.motivoAnulacion</div> }
</div></div>
<div class="modal fade" id="modalAnular"><div class="modal-dialog"><div class="modal-content"><form method="post" action="@Url.Action("Anular")"><div class="modal-header"><button type="button" class="close" data-dismiss="modal">&times;</button><h4>Anular póliza</h4></div><div class="modal-body"><input type="hidden" name="idPoliza" value="@Model.idPoliza" /><div class="form-group"><label>Motivo de anulación</label><textarea name="motivoAnulacion" class="form-control" rows="4" required></textarea></div></div><div class="modal-footer"><button type="button" class="btn btn-default" data-dismiss="modal">Cerrar</button><button type="submit" class="btn btn-danger">Confirmar anulación</button></div></form></div></div></div>
